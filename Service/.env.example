# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Configuration — use a random 32+ character string in production
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Database
# Local dev (Docker Compose):
DATABASE_URL=postgresql://clearcomply:clearcomply_dev@127.0.0.1:5433/clearcomply
# Cloud Run (Cloud SQL via Unix socket):
# DATABASE_URL=postgresql://clearcomply:<PASSWORD>@/clearcomply?host=/cloudsql/<PROJECT>:<REGION>:<INSTANCE>

# CORS — comma-separated list of allowed frontend origins
# Local dev:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Cloud Run (set to the frontend Cloud Run URL):
# CORS_ORIGINS=https://clearcomply-frontend-xxxx-uc.a.run.app

# Session timeout in minutes (default: 240 = 4 hours)
SESSION_TIMEOUT_MINUTES=240

# API Configuration (local dev only — Cloud Run injects PORT automatically)
API_HOST=localhost
API_PORT=8000
