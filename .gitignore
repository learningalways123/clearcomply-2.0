*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Node.js dependencies and build outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# Docker
.dockerignore

# Temporary files
*.tmp
*.temp

# Coverage reports
htmlcov/
.coverage
.pytest_cache/
coverage/

# Database files (for future use)
*.db
*.sqlite3

# OS specific
.directory
